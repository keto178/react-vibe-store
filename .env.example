# Workspace-level backend defaults.
# Copy this file to .env or .env.local in the repository root.
# The backend also supports backend/.env for package-local workflows.

PORT=5000
NODE_ENV=development

# MongoDB Atlas example
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/app1-ecommerce?retryWrites=true&w=majority

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

ADMIN_USERNAME=store-admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisAdminPassword
ADMIN_NOTIFICATION_EMAIL=admin@example.com

PHONE_DATA_SECRET=replace-with-a-different-long-secret
PHONE_DEFAULT_COUNTRY_CODE=+20
