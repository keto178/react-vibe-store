PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/app1-ecommerce
JWT_SECRET=replace-this-with-a-secure-secret
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

ADMIN_USERNAME=store-admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345
ADMIN_NOTIFICATION_EMAIL=admin@example.com

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Store Notifications <no-reply@example.com>
