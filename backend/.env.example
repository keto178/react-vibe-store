PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/app1-ecommerce

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

STORAGE_PROVIDER=mock
ENABLE_DEV_MOCK_STORAGE=true
ALLOW_LEGACY_DATA_URL_UPLOADS=true
UPLOAD_MAX_BYTES=10485760

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=react-work

# Vercel Blob
BLOB_READ_WRITE_TOKEN=

# Admin bootstrap
ADMIN_USERNAME=store-admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisAdminPassword
ADMIN_NOTIFICATION_EMAIL=admin@example.com

# Email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Store Notifications <no-reply@example.com>

# Phone verification
PHONE_DATA_SECRET=replace-with-a-different-long-secret
PHONE_DEFAULT_COUNTRY_CODE=+20
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# MongoDB connection tuning
MONGO_SERVER_SELECTION_TIMEOUT_MS=15000
MONGO_CONNECT_TIMEOUT_MS=15000
MONGO_SOCKET_TIMEOUT_MS=45000
MONGO_CONNECT_RETRIES=2
MONGO_CONNECT_RETRY_DELAY_MS=1500
MONGO_MAX_POOL_SIZE=10
